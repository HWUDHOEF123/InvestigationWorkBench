# Copy to backend/.env and fill in. backend/.env is git-ignored.
# Spec: docs/requirements/13-setup.md

APP_MODE=live                          # live | fixture
API_HOST=127.0.0.1

# Neo4j (Homebrew service, listens on localhost only)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

GRAPHITI_TELEMETRY_ENABLED=false       # must be set before graphiti_core is imported
SEMAPHORE_LIMIT=4                      # Graphiti's internal concurrency for LLM, embedding and search calls

# LLM (OpenAI-compatible; default DeepSeek)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash               # Graphiti, vision and Q&A; confirm the exact ID in M0
LLM_SMALL_MODEL=deepseek-flash         # IntelGraph P2 classification only
LLM_STRUCTURED_OUTPUT=json_object      # DeepSeek supports json_object only
LLM_PROVIDER_PROFILE=deepseek          # maps thinking levels off/low/medium/high to request params

# Embeddings (OpenAI-compatible cloud service, multilingual; changing them requires re-embedding)
# Default: Alibaba Bailian. Use the OpenAI-compatible path /compatible-mode/v1
# (or <workspace-host>/compatible-mode/v1), not DashScope's native /api/v1.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024                     # must equal the model's native output dimension
